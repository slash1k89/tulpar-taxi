        <item name="android:windowSplashScreenBackground">@color/tulpar_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/tulpar_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/tulpar_splash_background</item>
        <item name="android:navigationBarColor">@color/tulpar_splash_background</item>
