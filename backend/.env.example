# Own Tulpar authentication. Firebase remains a transitional fallback.
# Generate a strong random secret outside source control; minimum 32 characters.
TULPAR_AUTH_ACCESS_SECRET=
# TTL values are integer seconds.
TULPAR_AUTH_ACCESS_TTL=900
TULPAR_AUTH_REFRESH_TTL=2592000

# OTP challenge lifecycle. The raw OTP is never persisted.
TULPAR_AUTH_OTP_SECRET=
TULPAR_AUTH_OTP_TTL=300
TULPAR_AUTH_OTP_MAX_ATTEMPTS=5
TULPAR_AUTH_OTP_RESEND_COOLDOWN=60

# Primary verification transport: AutoCall.kz Flash Call auto-code.
TULPAR_VERIFICATION_PROVIDER=autocall
AUTOCALL_API_TOKEN=
AUTOCALL_API_BASE=https://autocall.kz/api/v1
AUTOCALL_FLASHCALL_DIGITS=4
AUTOCALL_TIMEOUT_MS=8000
AUTH_VERIFICATION_RATE_LIMIT_WINDOW_MS=600000
AUTH_VERIFICATION_RATE_LIMIT_MAX=10

# Internal OSRM routing service. Do not use the public demo server in production.
OSRM_BASE_URL=http://tulpar-osrm:5000

# SMS provider. Keep credentials outside source control.
TULPAR_SMS_PROVIDER=mobizon
MOBIZON_API_KEY=
MOBIZON_SENDER=
MOBIZON_API_BASE=https://api.mobizon.kz/service
MOBIZON_SMS_TEMPLATE=Код MEKEN: {code}. Никому не сообщайте этот код.
MOBIZON_TIMEOUT_MS=8000
